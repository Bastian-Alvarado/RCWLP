<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- Tinted with the DualShock 4 lightbar colour a game sets, like a player light. -->
    <View
        android:id="@+id/lightbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:visibility="gone" />

    <!-- Laid out like SimonSays's splash: the logo, a heavy title and a short rose bar. -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/logo_tile" />

        <TextView
            android:id="@+id/host_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_black"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bar_accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rose while connected, grey otherwise. -->
            <View
                android:id="@+id/status_light"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_light" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textColor="@color/zinc_100"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/controller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/zinc_400"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/rose_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hint"
            style="@style/RCWLP.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/controller_hint"
            android:textColor="@color/zinc_600" />
    </LinearLayout>

    <Button
        android:id="@+id/disconnect"
        style="@style/RCWLP.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:drawableStart="@drawable/ic_power"
        android:text="@string/disconnect" />
</FrameLayout>
