<?xml version="1.0" encoding="utf-8"?>
<!-- A setting as a SimonSays tile: rose edge and tint when on, a plain zinc edge when off. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rose_pressed">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <solid android:color="@color/rose_tint" />
                    <stroke android:width="1dp" android:color="@color/rose" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/zinc_950" />
                    <stroke android:width="1dp" android:color="@color/zinc_800" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
