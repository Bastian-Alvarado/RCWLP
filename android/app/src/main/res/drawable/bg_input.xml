<?xml version="1.0" encoding="utf-8"?>
<!-- SimonSays's text field: zinc-950 with a zinc-800 edge, rose while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/zinc_950" />
            <stroke android:width="1dp" android:color="@color/rose" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/zinc_950" />
            <stroke android:width="1dp" android:color="@color/zinc_800" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
